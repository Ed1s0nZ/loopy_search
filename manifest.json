{
  "manifest_version": 3,
  "incognito": "split",
  "name": "AI划词搜索",
  "version": "1.0",
  "description": "选中文本，使用AI解释内容",
  "permissions": [
    "storage",
    "contextMenus",
    "alarms",
    "scripting",
    "clipboardWrite",
    "tabs",
    "proxy",
    "sidePanel",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "security/public-storage.js",
        "marked.min.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "search_with_ai": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A"
      },
      "description": "使用AI解释选中的文本"
    },
    "open_browser_assistant": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "打开 AI 浏览器助手"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "images/*",
        "marked.min.js",
        "content.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "assistant.html"
  },
  "options_page": "popup.html"
}
